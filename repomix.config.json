{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml"
  },
  "ignore": {
    "customPatterns": [
      "**/.env",
      "**/.env.*",
      "**/*secret*",
      "**/*credentials*",
      "**/*private-key*",
      "**/*.pem",
      "**/*.key",
      "**/*.p12",
      "**/*.pfx",
      "**/auth.json",
      "**/id_rsa*",
      "**/id_ed25519*",
      "**/repomix-output*",
      "**/repomix-*.xml",
      "**/repomix-*.md",
      "**/node_modules/**",
      "**/vendor/**",
      "**/.git/**",
      "**/storage/logs/**",
      "**/storage/framework/**",
      "**/storage/app/**",
      "**/bootstrap/cache/**",
      "**/public/storage/**",
      "**/public/build/**",
      "**/public/hot*",
      "**/coverage/**",
      "**/test-results/**",
      "**/debug-report-*/**",
      "**/backup/**",
      "**/backups/**",
      "**/deploy-backups/**",
      "**/git-backups/**",
      "**/*.sql",
      "**/*.sqlite",
      "**/*.sqlite3",
      "**/*.log",
      "**/*.bak",
      "**/*.bak.*",
      "**/*.zip",
      "**/*.tar",
      "**/*.gz",
      "**/*.pdf",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.webp",
      "**/*.gif",
      "**/*.ico",
      "**/*.woff",
      "**/*.woff2",
      "**/*.mp4",
      "**/*.mp3"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
