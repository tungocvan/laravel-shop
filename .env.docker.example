APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_REDIS
REDIS_PORT=6379

# Queue chung
QUEUE_NAMES=facebook,default
QUEUE_SLEEP=3
QUEUE_TRIES=3
QUEUE_TIMEOUT=660
QUEUE_MAX_TIME=3600
QUEUE_MEMORY_LIMIT=1400m
QUEUE_CPU_LIMIT=1.5

# Queue Admission Documents
ADMISSION_QUEUE_SLEEP=2
ADMISSION_QUEUE_TRIES=3
ADMISSION_QUEUE_TIMEOUT=180
ADMISSION_QUEUE_MAX_JOBS=100
ADMISSION_QUEUE_MAX_TIME=3600
ADMISSION_QUEUE_MEMORY_LIMIT=768m
ADMISSION_QUEUE_CPU_LIMIT=1.0

# Chỉ cần khi dùng Socket.IO
NODEJS_SERVER_URL=http://socket:6001
NODEJS_SERVER_PORT=6001
BRIDGE_SECRET_KEY=CHANGE_ME_BRIDGE

# Modules/Muasamcong
# Cập nhật các giá trị này ở .env trên Docker host trước khi build/redeploy image.
MUASAMCONG_ORIGIN=https://muasamcong.mpi.gov.vn
MUASAMCONG_VERIFY_SSL=true
MUASAMCONG_TIMEOUT=20
MUASAMCONG_USER_AGENT="Mozilla/5.0 (compatible; Laravel Muasamcong Module)"
MUASAMCONG_SMART_TOKEN=
MUASAMCONG_SESSION_COOKIE=
MUASAMCONG_PRICING_ENDPOINT=https://muasamcong.mpi.gov.vn/o/egp-portal-personal-page/services/smart/search_prc
MUASAMCONG_CONTRACTOR_ENDPOINT=https://muasamcong.mpi.gov.vn/o/egp-portal-contractor-selection-v2/services/smart/search
MUASAMCONG_PORTAL_REFERER=https://muasamcong.mpi.gov.vn/
MUASAMCONG_PRICING_REFERER="https://muasamcong.mpi.gov.vn/web/guest/profile-info?menu=bid-pricing"
MUASAMCONG_PAGE_SIZE=20
